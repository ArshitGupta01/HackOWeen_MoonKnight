CREATE TABLE IF NOT EXISTS PilotCase (
 id TEXT NOT NULL PRIMARY KEY, title TEXT NOT NULL, description TEXT NOT NULL, category TEXT NOT NULL,
 address TEXT NOT NULL, latitude REAL, longitude REAL, citizenId TEXT NOT NULL, department TEXT NOT NULL,
 priority TEXT NOT NULL, status TEXT NOT NULL, createdAt INTEGER NOT NULL, updatedAt INTEGER NOT NULL,
 dueAt INTEGER NOT NULL, version INTEGER NOT NULL, escalation INTEGER NOT NULL, closureBy TEXT
);
CREATE INDEX IF NOT EXISTS PilotCase_owner ON PilotCase(citizenId);
CREATE INDEX IF NOT EXISTS PilotCase_deadline ON PilotCase(status, dueAt);
CREATE TABLE IF NOT EXISTS PilotTask (
 id TEXT NOT NULL PRIMARY KEY, caseId TEXT NOT NULL REFERENCES PilotCase(id), department TEXT NOT NULL,
 title TEXT NOT NULL, required INTEGER NOT NULL, complete INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS PilotEvent (
 id TEXT NOT NULL PRIMARY KEY, caseId TEXT NOT NULL REFERENCES PilotCase(id), actorId TEXT NOT NULL,
 action TEXT NOT NULL, note TEXT NOT NULL, at INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS PilotEvent_case ON PilotEvent(caseId, at);
CREATE TABLE IF NOT EXISTS PilotReceipt (
 actorId TEXT NOT NULL, key TEXT NOT NULL, fingerprint TEXT NOT NULL, caseId TEXT NOT NULL REFERENCES PilotCase(id),
 PRIMARY KEY(actorId, key)
);
CREATE TABLE IF NOT EXISTS PilotLink (
 caseId TEXT NOT NULL REFERENCES PilotCase(id), targetId TEXT NOT NULL REFERENCES PilotCase(id), kind TEXT NOT NULL,
 PRIMARY KEY(caseId, targetId, kind)
);
CREATE TABLE IF NOT EXISTS LegalSource (
 id TEXT NOT NULL PRIMARY KEY, title TEXT NOT NULL, url TEXT NOT NULL, jurisdiction TEXT NOT NULL,
 language TEXT NOT NULL, content TEXT NOT NULL, hash TEXT NOT NULL, retrievedAt INTEGER NOT NULL,
 status TEXT NOT NULL, reviewedBy TEXT, supersedes TEXT
);
