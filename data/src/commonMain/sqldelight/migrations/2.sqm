CREATE TABLE IF NOT EXISTS LegalMonitor (
 id TEXT NOT NULL PRIMARY KEY, remoteMonitorId TEXT, name TEXT NOT NULL, monitorType TEXT NOT NULL,
 target TEXT NOT NULL, jurisdiction TEXT NOT NULL, language TEXT NOT NULL, scheduleCron TEXT NOT NULL,
 status TEXT NOT NULL, lastCheckedAt INTEGER, lastStatus TEXT
);

CREATE TABLE IF NOT EXISTS ComplaintEntity (
    id TEXT PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    category TEXT NOT NULL,
    priority TEXT NOT NULL,
    status TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    address TEXT NOT NULL,
    citizenId TEXT NOT NULL,
    assignedWorkerId TEXT,
    zone TEXT NOT NULL,
    photoUrl TEXT,
    resolutionNotes TEXT,
    resolutionPhotoUrl TEXT,
    clusterId TEXT,
    slaDueEpochMillis INTEGER NOT NULL,
    createdAtEpochMillis INTEGER NOT NULL,
    updatedAtEpochMillis INTEGER NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS AuditLogEntity (
    id TEXT PRIMARY KEY NOT NULL,
    complaintId TEXT NOT NULL,
    actorType TEXT NOT NULL,
    actorId TEXT NOT NULL,
    action TEXT NOT NULL,
    reasoning TEXT NOT NULL,
    decisionPayloadJson TEXT,
    timestampEpochMillis INTEGER NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 1
);
