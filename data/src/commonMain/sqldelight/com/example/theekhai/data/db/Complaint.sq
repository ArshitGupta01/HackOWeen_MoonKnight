CREATE TABLE ComplaintEntity (
    id TEXT PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    category TEXT NOT NULL,
    priority TEXT NOT NULL,
    status TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    address TEXT NOT NULL,
    citizenId TEXT NOT NULL,
    assignedWorkerId TEXT,
    zone TEXT NOT NULL,
    photoUrl TEXT,
    resolutionNotes TEXT,
    resolutionPhotoUrl TEXT,
    clusterId TEXT,
    slaDueEpochMillis INTEGER NOT NULL,
    createdAtEpochMillis INTEGER NOT NULL,
    updatedAtEpochMillis INTEGER NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 1
);

selectAll:
SELECT * FROM ComplaintEntity ORDER BY updatedAtEpochMillis DESC;

selectById:
SELECT * FROM ComplaintEntity WHERE id = :id;

selectUnsynced:
SELECT * FROM ComplaintEntity WHERE isSynced = 0;

insertOrReplace:
INSERT OR REPLACE INTO ComplaintEntity(
    id, title, description, category, priority, status,
    latitude, longitude, address, citizenId, assignedWorkerId,
    zone, photoUrl, resolutionNotes, resolutionPhotoUrl, clusterId,
    slaDueEpochMillis, createdAtEpochMillis, updatedAtEpochMillis, isSynced
) VALUES (
    ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?,
    ?, ?, ?, ?
);

updateStatus:
UPDATE ComplaintEntity
SET status = :status, updatedAtEpochMillis = :updatedAt, isSynced = :isSynced
WHERE id = :id;

updateTriage:
UPDATE ComplaintEntity
SET clusterId = :clusterId, priority = :priority, category = :category, updatedAtEpochMillis = :updatedAt, isSynced = :isSynced
WHERE id = :id;

updateResolution:
UPDATE ComplaintEntity
SET status = 'RESOLVED', assignedWorkerId = :workerId, resolutionNotes = :resolutionNotes, resolutionPhotoUrl = :resolutionPhotoUrl, updatedAtEpochMillis = :updatedAt, isSynced = :isSynced
WHERE id = :id;

markSynced:
UPDATE ComplaintEntity SET isSynced = 1 WHERE id = :id;

deleteById:
DELETE FROM ComplaintEntity WHERE id = :id;
