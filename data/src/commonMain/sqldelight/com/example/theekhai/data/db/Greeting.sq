-- Single SQLite schema shared by Android, iOS, Desktop and the Ktor server.
-- Add migrations as `src/commonMain/sqldelight/migrations/<n>.sqm` when this changes.

CREATE TABLE GreetingEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    message TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

selectAll:
SELECT * FROM GreetingEntity ORDER BY created_at DESC, id DESC;

insert:
INSERT INTO GreetingEntity(message, created_at) VALUES (?, ?);

lastInsertedId:
SELECT last_insert_rowid();
